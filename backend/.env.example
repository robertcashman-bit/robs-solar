# Rob's Solar / Rob's Finance — backend configuration
# Copy to .env and edit. Never commit .env.

# --- Core ---
APP_ENV=development
SECRET_KEY=change-me
DATABASE_URL=sqlite+aiosqlite:///./data/robs_solar.db
# Hosted Vercel keeps DATABASE_URL as sqlite /tmp. Production then uses the
# prefixed Neon URL if present. Do not overwrite a working DATABASE_URL.
# ROBS_FINANCE_DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=
CORS_ORIGINS=http://127.0.0.1:3000

# --- Auth (change before exposing to any network) ---
# App login email or username + password (never commit the real password)
ADMIN_USERNAME=admin
ADMIN_EMAIL=robertdavidcashman@gmail.com
ADMIN_PASSWORD=change-me-admin
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-me-viewer

# --- Safety defaults ---
READ_ONLY=true
ENABLE_LIVE_WRITES=false
ADAPTER_MODE=simulator

# --- Polling / rate limits ---
DEFAULT_POLL_INTERVAL_SECONDS=5
RATE_LIMIT_WRITES_PER_MINUTE=10

# --- Home Assistant (optional) ---
# HA_BASE_URL=
# HA_TOKEN=
# HA_ENTITY_PV_POWER=
# HA_ENTITY_BATTERY_SOC=
# HA_ENTITY_HOUSE_LOAD=
# HA_ENTITY_GRID_IMPORT=
# HA_ENTITY_GRID_EXPORT=
# HA_ENTITY_INVERTER_MODE=
# HA_ENTITY_INVERTER_STATUS=
# HA_ENTITY_EXPORT_LIMIT=
# HA_SERVICE_EXPORT_LIMIT=script.your_export_limit_script
# HA_SERVICE_SCHEDULE=script.your_schedule_script
# HA_SERVICE_OPERATING_MODE=script.your_mode_script

# --- Modbus TCP (RS485-WiFi dongle) ---
# MODBUS_HOST=
# MODBUS_PORT=502
# MODBUS_SLAVE_ID=1

# --- Modbus HTTP bridge (optional) ---
# MODBUS_BRIDGE_URL=
# MODBUS_BRIDGE_TOKEN=
# MODBUS_BRIDGE_WRITES_ENABLED=false

# --- Octopus Energy ---
# OCTOPUS_API_KEY=
# OCTOPUS_ACCOUNT_NUMBER=
# OCTOPUS_MPAN=
# OCTOPUS_METER_SERIAL=
# OCTOPUS_DEVICE_ID=
# OCTOPUS_TARIFF=AGILE
# OCTOPUS_REGION=C

# --- Solar forecast (Open-Meteo) ---
# FORECAST_LATITUDE=51.5074
# FORECAST_LONGITUDE=-0.1278
# PANEL_COUNT_EW=16
# PANEL_COUNT_W=6
# PANEL_WATTAGE=480

# --- Metrics sampler ---
METRICS_SAMPLER_ENABLED=true
METRICS_SAMPLE_INTERVAL_SECONDS=60
METRICS_RETENTION_DAYS=90

# Read-only inverter settings watcher (detects changes; never writes)
SETTINGS_WATCH_ENABLED=true
SETTINGS_WATCH_EVERY_N_SAMPLES=3
SETTINGS_WATCH_RETENTION_DAYS=90

# --- Tariff defaults (GBP/kWh) ---
TARIFF_IMPORT_RATE=0.28
TARIFF_EXPORT_RATE=0.15
TARIFF_CURRENCY=GBP
TARIFF_TIMEZONE=Europe/London

# --- IOG / auto-schedule ---
# IOG_OFFPEAK_RATE_GBP=0.07
# IOG_OFFPEAK_START=23:30
# IOG_OFFPEAK_END=05:30
AUTO_SCHEDULE_ENABLED=false
AUTO_SCHEDULE_SOC_FLOOR_PCT=20
AUTO_SCHEDULE_OVERNIGHT_TARGET_PCT=100
PEAK_IMPORT_GUARD_ENABLED=true

# --- AI assistant (admin-only; backend only) ---
AI_ENABLED=false
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini

# --- QuickFile (business finance sync) ---
# QUICKFILE_ACCOUNT_NUMBER=
# QUICKFILE_API_KEY=
# QUICKFILE_APPLICATION_ID=

# --- Open Banking (TrueLayer) ---
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# TRUELAYER_REDIRECT_URI=
# TRUELAYER_ENVIRONMENT=sandbox

# --- Lunch Flow (Open Banking via existing bank connections) ---
# In Lunch Flow: Destinations → API → copy the key, then Save / Test / Sync in Settings.
# Accepts LUNCHFLOW_API_KEY or the older LUNCH_FLOW_API_KEY name from previous deploys.
# LUNCHFLOW_API_KEY=
# LUNCH_FLOW_API_KEY=

# --- Tesla Fleet API ---
# TESLA_CLIENT_ID=
# TESLA_CLIENT_SECRET=
# TESLA_REFRESH_TOKEN=
# TESLA_ENERGY_SITE_ID=

# --- OIDC SSO (optional) ---
# OIDC_ENABLED=false
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_ADMIN_EMAILS=you@example.com

# --- Magic-code email OTP sign-in (a new 6-digit code is emailed every request) ---
# MAGIC_CODE_ENABLED=true
# MAGIC_CODE_TTL_SECONDS=600
# Comma-separated allowlists (also always includes ADMIN_EMAIL)
MAGIC_CODE_ADMIN_EMAILS=robertdavidcashman@gmail.com
# MAGIC_CODE_VIEWER_EMAILS=
# Sign-in emails always use this host — never a Cloudflare tunnel.
PUBLIC_APP_URL=https://robs-solar.vercel.app
# Resend (https://resend.com) — required for real email delivery in production.
# Without RESEND_API_KEY, local/dev returns the code in the API response.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Rob's Finance <onboarding@resend.dev>

# --- Alerts ---
# ALERT_WEBHOOK_URL=
